# ==========================================================================
# Nocturne Prints — przyklad konfiguracji srodowiska.
# Skopiuj do `.env` i uzupelnij. NIE commituj prawdziwego `.env`.
# ==========================================================================

# --- Aplikacja ---
# Publiczny URL aplikacji (uzywany m.in. przez Stripe redirecty).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Baza danych (PostgreSQL) ---
DATABASE_URL="postgresql://nocturne:nocturne@localhost:5432/nocturne?schema=public"

# --- Admin panel (auth) ---
# Login + hash hasla. Wygeneruj hash skryptem: `npm run db:seed` wypisze instrukcje,
# lub uzyj node: require('crypto').scryptSync(...).
ADMIN_EMAIL="admin@nocturne.local"
# Haslo w plain-text TYLKO dla seeda lokalnego MVP. W produkcji ustaw ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD="change-me-now"
# Sekret do podpisywania sesyjnych cookie (min. 32 znaki losowe).
AUTH_SECRET="zmien-na-dlugi-losowy-sekret-min-32-znaki"

# --- Storage (upload zdjec) ---
# Adapter: "local" | "s3"
STORAGE_DRIVER="local"
# Dla adaptera lokalnego: katalog na pliki (poza repo).
LOCAL_STORAGE_DIR="./storage/uploads"
# Bazowy URL do serwowania plikow lokalnych przez API.
LOCAL_STORAGE_PUBLIC_BASE="/api/assets"

# Dla adaptera S3/R2 (Cloudflare R2 jest kompatybilne z S3):
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Kolejka zadan ---
# Adapter: "memory" | "bullmq"
QUEUE_DRIVER="memory"
REDIS_URL="redis://localhost:6379"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Waluta zamowien.
CURRENCY="pln"

# --- Moderacja (adaptery zewnetrzne, opcjonalne w MVP) ---
# Adapter moderacji obrazu: "mock" | "external"
IMAGE_MODERATION_DRIVER="mock"
IMAGE_MODERATION_API_URL=""
IMAGE_MODERATION_API_KEY=""
# Adapter moderacji promptu (LLM): "rules" | "llm"
PROMPT_MODERATION_DRIVER="rules"
LLM_MODERATION_API_URL=""
LLM_MODERATION_API_KEY=""

# --- Generowanie grafiki AI ---
# Adapter: "mock" | "external"
IMAGE_GENERATION_DRIVER="mock"
IMAGE_GENERATION_API_URL=""
IMAGE_GENERATION_API_KEY=""

# --- Limity uploadu ---
MAX_UPLOAD_BYTES="10485760"        # 10 MB
MAX_IMAGE_DIMENSION="6000"         # max szerokosc/wysokosc w px
